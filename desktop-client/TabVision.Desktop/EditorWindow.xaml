<Window x:Class="TabVision.Desktop.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TabVision.Desktop.Controls"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="TabVision Studio — Refine"
        Width="1280"
        Height="820"
        MinWidth="940"
        MinHeight="620"
        PreviewKeyDown="Window_PreviewKeyDown"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Rectangle Fill="{StaticResource WindowGlowBrush}" IsHitTestVisible="False" />
        <Grid Margin="22,16,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Studio header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource AccentGradientBrush}" Effect="{StaticResource AccentShadow}">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="21" Text="&#xE8D6;" />
                </Border>
                <StackPanel Grid.Column="1" Margin="13,0,20,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="TabVision Studio" />
                        <Border Margin="10,0,0,0" Padding="8,3" Background="{StaticResource AccentSoftBrush}" BorderBrush="#558B5CF6" BorderThickness="1" CornerRadius="10">
                            <TextBlock Foreground="#C4B5FD" FontSize="10" FontWeight="Bold" Text="REFINE" />
                        </Border>
                    </StackPanel>
                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                        <TextBox x:Name="TitleTextBox" Width="300" Height="27" MinHeight="0" Padding="7,3" FontSize="12"
                                 AutomationProperties.Name="Transcription title" LostKeyboardFocus="TitleTextBox_LostKeyboardFocus"
                                 PreviewKeyDown="TitleTextBox_PreviewKeyDown" />
                        <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" Style="{StaticResource CaptionText}" Text="Autosaves locally" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Margin="0,0,7,0" Style="{StaticResource GhostButton}" Click="Shortcuts_Click" Content="Shortcuts" />
                    <Button Margin="0,0,7,0" Style="{StaticResource SecondaryButton}" Click="Copy_Click" Content="Copy tab" />
                    <Button Style="{StaticResource PrimaryButton}" Click="Export_Click" Content="Export tab" />
                </StackPanel>
            </Grid>

            <!-- Transport -->
            <Border Grid.Row="1" Margin="0,14,0,0" Padding="12" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PlayButton" Width="76" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Play or pause" Click="Play_Click" Content="Play" />
                        <Button Margin="7,0,0,0" Style="{StaticResource IconButton}" ToolTip="Back 5 seconds" AutomationProperties.Name="Back 5 seconds" Click="SkipBack_Click" Content="&#xE892;" />
                        <Button Margin="3,0,0,0" Style="{StaticResource IconButton}" ToolTip="Forward 5 seconds" AutomationProperties.Name="Forward 5 seconds" Click="SkipForward_Click" Content="&#xE893;" />
                    </StackPanel>
                    <TextBlock x:Name="PlaybackTimeText" Grid.Column="1" Width="88" Margin="12,0" VerticalAlignment="Center" TextAlignment="Center" FontFamily="Cascadia Mono" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Text="0:00 / 0:00" />
                    <Slider x:Name="VideoPositionSlider" Grid.Column="2" Margin="0,0,14,0" VerticalAlignment="Center" AutomationProperties.Name="Playback position" ValueChanged="VideoPositionSlider_ValueChanged" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Margin="0,0,7,0" VerticalAlignment="Center" Style="{StaticResource CaptionText}" Text="Hear" />
                        <ComboBox x:Name="AuditionModeComboBox" Width="92" AutomationProperties.Name="Audition mode" SelectionChanged="AuditionModeComboBox_SelectionChanged" />
                        <TextBlock Margin="12,0,7,0" VerticalAlignment="Center" Style="{StaticResource CaptionText}" Text="Speed" />
                        <ComboBox x:Name="PlaybackRateComboBox" Width="72" AutomationProperties.Name="Playback speed" SelectionChanged="PlaybackRateComboBox_SelectionChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" Margin="14,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="FollowButton" Style="{StaticResource SecondaryButton}" Click="Follow_Click" Content="Follow on" />
                        <Button x:Name="VideoToggleButton" Margin="6,0,0,0" Style="{StaticResource SecondaryButton}" Click="ToggleVideo_Click" Content="Show source" />
                        <Button x:Name="MuteVideoButton" Margin="6,0,0,0" Style="{StaticResource GhostButton}" Click="MuteVideo_Click" Content="Mute" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Source preview -->
            <Border x:Name="VideoPanel" Grid.Row="2" Height="200" Margin="0,12,0,0" Background="#05070B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" ClipToBounds="True" Visibility="Collapsed">
                <Grid>
                    <MediaElement x:Name="VideoElement" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform"
                                  MediaOpened="VideoElement_MediaOpened" MediaEnded="VideoElement_MediaEnded" />
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="8,4" Background="#CC101722" CornerRadius="7">
                        <TextBlock Style="{StaticResource CaptionText}" Text="SOURCE RECORDING" />
                    </Border>
                </Grid>
            </Border>

            <!-- Editing workspace -->
            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="560" />
                    <ColumnDefinition Width="294" />
                </Grid.ColumnDefinitions>

                <Border Margin="0,0,12,0" Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="14,11">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Arrangement" />
                                <Border Margin="9,0,0,0" Padding="7,3" Background="#172233" CornerRadius="8">
                                    <TextBlock x:Name="SelectionBadgeText" Style="{StaticResource CaptionText}" Text="0 selected" />
                                </Border>
                                <TextBlock x:Name="DocumentMetaText" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource CaptionText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="TimelineViewButton" Style="{StaticResource SecondaryButton}" Click="ShowTimeline_Click" Content="Timeline" />
                                <Button x:Name="TabViewButton" Margin="5,0,0,0" Style="{StaticResource GhostButton}" Click="ShowTab_Click" Content="Score" />
                                <Border Margin="12,0,6,0" Width="1" Background="{StaticResource BorderBrush}" />
                                <Button Style="{StaticResource IconButton}" ToolTip="Zoom out" Click="ZoomOut_Click" Content="&#xE71F;" />
                                <Button Margin="3,0,0,0" Style="{StaticResource GhostButton}" Click="ZoomReset_Click">
                                    <TextBlock x:Name="ZoomText" FontFamily="Cascadia Mono" Text="100%" />
                                </Button>
                                <Button Margin="3,0,0,0" Style="{StaticResource IconButton}" ToolTip="Zoom in" Click="ZoomIn_Click" Content="&#xE8A3;" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <ScrollViewer x:Name="TimelineScroll" Margin="1,0,1,1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <controls:EditorTimeline x:Name="Timeline" Focusable="True" />
                            </ScrollViewer>
                            <ScrollViewer x:Name="TabPreviewScroll" Margin="18,6,18,18" Background="#0A0F17" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                <controls:EditorScoreView x:Name="ScoreView" HorizontalAlignment="Center" Focusable="True" />
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Inspector -->
                <Border Grid.Column="1" Padding="16" Style="{StaticResource CardBorder}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Style="{StaticResource EyebrowText}" Text="NOTE INSPECTOR" />
                            <TextBlock x:Name="SelectionText" Margin="0,6,0,0" FontSize="17" FontWeight="SemiBold" Text="Select a note" />
                            <TextBlock x:Name="HintText" Margin="0,5,0,0" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Text="Click a note to edit. Ctrl-click adds notes and Shift-click selects a range." />

                            <Border Margin="0,15,0,0" Padding="12" Background="#101925" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="CONFIDENCE" />
                                    <UniformGrid Margin="0,9,0,0" Columns="3">
                                        <Button x:Name="HighConfidenceButton" Margin="0,0,4,0" Padding="5" Click="HighConfidence_Click" />
                                        <Button x:Name="MediumConfidenceButton" Margin="2,0" Padding="5" Click="MediumConfidence_Click" />
                                        <Button x:Name="LowConfidenceButton" Margin="4,0,0,0" Padding="5" Click="LowConfidence_Click" />
                                    </UniformGrid>
                                    <Button x:Name="ReviewButton" Margin="0,8,0,0" Style="{StaticResource SecondaryButton}" Click="Review_Click" Content="Review lowest confidence" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Button Margin="0,0,3,0" Style="{StaticResource GhostButton}" Click="PreviousReview_Click" Content="Previous" />
                                        <Button Grid.Column="1" Margin="3,0,0,0" Style="{StaticResource GhostButton}" Click="NextReview_Click" Content="Next" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="0,17,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="FINGERING" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="FretTextBox" AutomationProperties.Name="Fret number" VerticalContentAlignment="Center" />
                                <Button Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource SecondaryButton}" Click="ApplyFret_Click" Content="Set" />
                            </Grid>
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Button Margin="0,0,3,0" Click="StringUp_Click" Content="String up" />
                                <Button Grid.Column="1" Margin="3,0,0,0" Click="StringDown_Click" Content="String down" />
                            </Grid>
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Button Margin="0,0,3,0" Click="PreviousCandidate_Click" Content="Prev candidate" />
                                <Button Grid.Column="1" Margin="3,0,0,0" Click="NextCandidate_Click" Content="Next candidate" />
                            </Grid>

                            <TextBlock Margin="0,17,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="TIMING" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Button Margin="0,0,3,0" Click="NudgeBack_Click" Content="− 10 ms" />
                                <Button Grid.Column="1" Margin="3,0,0,0" Click="NudgeForward_Click" Content="+ 10 ms" />
                            </Grid>

                            <Grid Margin="0,17,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Button Margin="0,0,3,0" Style="{StaticResource SecondaryButton}" Click="Mute_Click" Content="Mute" />
                                <Button Grid.Column="1" Margin="3,0,0,0" Style="{StaticResource DangerButton}" Click="Delete_Click" Content="Delete" />
                            </Grid>
                            <Button Margin="0,7,0,0" Style="{StaticResource GhostButton}" Click="Insert_Click" Content="Insert note at playhead" />

                            <Border Margin="0,17,0,0" Height="1" Background="{StaticResource BorderBrush}" />
                            <TextBlock Margin="0,14,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Text="EXPORT" />
                            <Button Margin="0,8,0,0" Style="{StaticResource SecondaryButton}" Click="ExportMidi_Click" Content="Export quantized MIDI" />
                            <Button Margin="0,7,0,0" Style="{StaticResource SecondaryButton}" Click="Print_Click" Content="Print / save PDF" />
                            <Button x:Name="BankGoldButton" Margin="0,7,0,0" Style="{StaticResource SecondaryButton}" Click="BankGold_Click" Content="Bank corrected take" />
                            <TextBlock x:Name="BankGoldStatusText" Margin="0,6,0,0" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Status strip -->
            <Grid Grid.Row="4" Margin="2,10,2,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Margin="0,0,7,0" Fill="{StaticResource SuccessBrush}" />
                    <TextBlock x:Name="AutosaveStatusText" Style="{StaticResource CaptionText}" Text="All changes saved locally" />
                    <TextBlock Margin="10,0" Style="{StaticResource CaptionText}" Text="•" />
                    <TextBlock Style="{StaticResource CaptionText}" Text="Drag notes to retime or restring • Ctrl-click adds • Shift-click selects range" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="UndoButton" MinHeight="26" Padding="9,4" Style="{StaticResource GhostButton}" Click="Undo_Click" Content="Undo" />
                    <Button x:Name="RedoButton" MinHeight="26" Padding="9,4" Style="{StaticResource GhostButton}" Click="Redo_Click" Content="Redo" />
                    <Button Margin="8,0,0,0" MinHeight="26" Padding="9,4" Style="{StaticResource GhostButton}" Click="DiscardAutosave_Click" Content="Discard autosave" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
