<Window x:Class="TabVision.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TabVision"
        Width="760"
        Height="750"
        MinWidth="620"
        MinHeight="660"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="28"
                   FontWeight="SemiBold"
                   Text="TabVision" />
        <TextBlock Grid.Row="1"
                   Margin="0,6,0,24"
                   Foreground="#666666"
                   Text="Choose a guitar video to begin a local transcription."
                   TextWrapping="Wrap" />

        <Border Grid.Row="2"
                Padding="20"
                BorderBrush="#D6D6D6"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontSize="16"
                               FontWeight="SemiBold"
                               Text="Input video" />
                    <TextBlock Margin="0,4,16,0"
                               Foreground="#666666"
                               Text="MP4, MOV, M4V, AVI, MKV, WebM, or another media file."
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="ChooseVideoButton"
                        Grid.Column="1"
                        MinWidth="118"
                        Padding="14,8"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Choose video"
                        Click="ChooseVideo_Click"
                        Content="Choose video..." />

                <Grid Grid.Row="1"
                      Grid.ColumnSpan="2"
                      Margin="0,20,0,0">
                    <TextBlock x:Name="NoInputText"
                               Foreground="#777777"
                               Text="No video selected." />
                    <StackPanel x:Name="SelectedInputPanel"
                                Visibility="Collapsed">
                        <TextBlock x:Name="SelectedFileNameText"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="SelectedFileDetailsText"
                                   Margin="0,3,0,0"
                                   Foreground="#555555" />
                        <TextBlock x:Name="SelectedFilePathText"
                                   Margin="0,3,0,0"
                                   Foreground="#777777"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Margin="0,18,0,0"
                Padding="20"
                BorderBrush="#D6D6D6"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel>
                <TextBlock FontSize="16"
                           FontWeight="SemiBold"
                           Text="Transcription options" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="#666666"
                           Text="Defaults follow the pinned TabVision pipeline."
                           TextWrapping="Wrap" />

                <UniformGrid Margin="-6,12,-6,0"
                             Columns="3">
                    <StackPanel Margin="6">
                        <TextBlock Margin="0,0,0,5"
                                   Text="Instrument" />
                        <ComboBox x:Name="InstrumentComboBox"
                                  MinWidth="150"
                                  AutomationProperties.Name="Instrument" />
                    </StackPanel>
                    <StackPanel Margin="6">
                        <TextBlock Margin="0,0,0,5"
                                   Text="Tone" />
                        <ComboBox x:Name="ToneComboBox"
                                  MinWidth="150"
                                  AutomationProperties.Name="Tone" />
                    </StackPanel>
                    <StackPanel Margin="6">
                        <TextBlock Margin="0,0,0,5"
                                   Text="Playing style" />
                        <ComboBox x:Name="StyleComboBox"
                                  MinWidth="150"
                                  AutomationProperties.Name="Playing style" />
                    </StackPanel>
                    <StackPanel Margin="6">
                        <TextBlock Margin="0,0,0,5"
                                   Text="Capo fret" />
                        <ComboBox x:Name="CapoComboBox"
                                  MinWidth="150"
                                  AutomationProperties.Name="Capo fret" />
                    </StackPanel>
                    <StackPanel Margin="6">
                        <TextBlock Margin="0,0,0,5"
                                   Text="Audio backend" />
                        <ComboBox x:Name="AudioBackendComboBox"
                                  MinWidth="150"
                                  AutomationProperties.Name="Audio backend" />
                    </StackPanel>
                </UniformGrid>

                <CheckBox x:Name="NoVideoCheckBox"
                          Margin="0,10,0,0"
                          AutomationProperties.Name="Audio only, skip video analysis"
                          Content="Audio only (--no-video)" />
            </StackPanel>
        </Border>

        <Border Grid.Row="4"
                Margin="0,18,0,0"
                Padding="20"
                BorderBrush="#D6D6D6"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,20,0"
                            VerticalAlignment="Center">
                    <ProgressBar x:Name="JobProgressBar"
                                 Height="8"
                                 Minimum="0"
                                 Maximum="100"
                                 AutomationProperties.Name="Transcription progress" />
                    <TextBlock x:Name="JobStatusText"
                               Margin="0,8,0,0"
                               Foreground="#666666"
                               Text="Choose an input to begin."
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button x:Name="TranscribeButton"
                        Grid.Column="1"
                        MinWidth="118"
                        Padding="14,9"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Transcribe selected video"
                        Click="Transcribe_Click"
                        Content="Transcribe"
                        IsEnabled="False" />
            </Grid>
        </Border>
    </Grid>
</Window>
