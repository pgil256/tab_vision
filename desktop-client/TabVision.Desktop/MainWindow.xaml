<Window x:Class="TabVision.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TabVision"
        Width="820"
        Height="820"
        MinWidth="620"
        MinHeight="480"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock FontSize="28"
                       FontWeight="SemiBold"
                       Text="TabVision" />
            <Menu Grid.Column="1"
                  VerticalAlignment="Center"
                  Background="Transparent">
                <MenuItem Padding="10,6"
                          AutomationProperties.Name="Settings"
                          Header="_Settings">
                    <MenuItem x:Name="RepairBootstrapMenuItem"
                              AutomationProperties.Name="Repair or re-download setup files"
                              Click="RepairBootstrapMenuItem_Click"
                              Header="_Repair / Re-download"
                              IsEnabled="False"
                              ToolTip="Revalidate setup and download only missing or corrupt files." />
                    <MenuItem x:Name="RestoreEditorMenuItem"
                              AutomationProperties.Name="Restore editor session"
                              Click="RestoreEditorMenuItem_Click"
                              Header="_Restore editor session"
                              IsEnabled="False" />
                </MenuItem>
            </Menu>
        </Grid>
        <TextBlock Grid.Row="1"
                   Margin="0,6,0,24"
                   Foreground="#666666"
                   Text="Record a guitar video live or upload one to begin a local transcription."
                   TextWrapping="Wrap" />

        <Border Grid.Row="2"
                Padding="20"
                BorderBrush="#D6D6D6"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontSize="16"
                               FontWeight="SemiBold"
                               Text="Input video" />
                    <TextBlock Margin="0,4,16,0"
                               Foreground="#666666"
                               Text="Record with a camera and microphone in TabVision, or upload MP4, MOV, M4V, AVI, MKV, WebM, or another media file."
                               TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="RecordVideoButton"
                            MinWidth="118"
                            Padding="14,8"
                            AutomationProperties.Name="Record live video"
                            Click="RecordVideo_Click"
                            Content="Record live" />
                    <Button x:Name="ChooseVideoButton"
                            Margin="8,0,0,0"
                            MinWidth="118"
                            Padding="14,8"
                            AutomationProperties.Name="Upload video"
                            Click="ChooseVideo_Click"
                            Content="Upload video..." />
                </StackPanel>

                <Border x:Name="CameraPanel"
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Margin="0,20,0,0"
                        Padding="14"
                        Background="#151515"
                        CornerRadius="6"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="280" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Margin="0,0,12,0"
                                       VerticalAlignment="Center"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       Text="Camera" />
                            <ComboBox x:Name="CameraComboBox"
                                      Grid.Column="1"
                                      MaxWidth="360"
                                      HorizontalAlignment="Left"
                                      VerticalContentAlignment="Center"
                                      AutomationProperties.Name="Camera"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="CameraComboBox_SelectionChanged" />
                            <Button x:Name="CloseCameraButton"
                                    Grid.Column="2"
                                    Margin="12,0,0,0"
                                    Padding="12,5"
                                    AutomationProperties.Name="Close camera"
                                    Click="CloseCamera_Click"
                                    Content="Close" />
                        </Grid>

                        <Border Grid.Row="1"
                                Margin="0,12"
                                Background="Black"
                                BorderBrush="#333333"
                                BorderThickness="1"
                                CornerRadius="4"
                                ClipToBounds="True">
                            <Grid>
                                <Image x:Name="CameraPreviewImage"
                                       AutomationProperties.Name="Live camera preview"
                                       Stretch="Uniform" />
                                <TextBlock x:Name="CameraPreviewPlaceholder"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="#CFCFCF"
                                           Text="Starting camera..."
                                           TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,16,0"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="CameraStatusText"
                                           Foreground="White"
                                           Text="Choose a camera to begin."
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="RecordingDurationText"
                                           Margin="0,3,0,0"
                                           Foreground="#FF8080"
                                           FontWeight="SemiBold"
                                           Text="00:00"
                                           Visibility="Collapsed" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button x:Name="StartCameraRecordingButton"
                                        MinWidth="92"
                                        Padding="12,7"
                                        AutomationProperties.Name="Start camera recording"
                                        Click="StartCameraRecording_Click"
                                        Content="Start"
                                        IsEnabled="False" />
                                <Button x:Name="StopCameraRecordingButton"
                                        Margin="8,0,0,0"
                                        MinWidth="92"
                                        Padding="12,7"
                                        AutomationProperties.Name="Stop camera recording"
                                        Click="StopCameraRecording_Click"
                                        Content="Stop"
                                        IsEnabled="False" />
                                <Button x:Name="UseCameraRecordingButton"
                                        Margin="8,0,0,0"
                                        MinWidth="100"
                                        Padding="12,7"
                                        AutomationProperties.Name="Use camera recording"
                                        Click="UseCameraRecording_Click"
                                        Content="Use video"
                                        IsEnabled="False" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="2"
                      Grid.ColumnSpan="2"
                      Margin="0,20,0,0">
                    <TextBlock x:Name="NoInputText"
                               Foreground="#777777"
                               Text="No video selected." />
                    <StackPanel x:Name="SelectedInputPanel"
                                Visibility="Collapsed">
                        <TextBlock x:Name="SelectedFileNameText"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="SelectedFileDetailsText"
                                   Margin="0,3,0,0"
                                   Foreground="#555555" />
                        <TextBlock x:Name="SelectedFilePathText"
                                   Margin="0,3,0,0"
                                   Foreground="#777777"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="OptionsPanel"
                Grid.Row="3"
                Margin="0,18,0,0"
                Padding="20"
                BorderBrush="#D6D6D6"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel>
                <TextBlock FontSize="16"
                           FontWeight="SemiBold"
                           Text="Transcription options" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="#666666"
                           Text="Defaults follow the pinned TabVision pipeline."
                           TextWrapping="Wrap" />

                <UniformGrid Margin="-6,12,-6,0"
                             Columns="3">
                    <StackPanel Margin="6">
                        <TextBlock Margin="0,0,0,5"
                                   Text="Instrument" />
                        <ComboBox x:Name="InstrumentComboBox"
                                  MinWidth="150"
                                  AutomationProperties.Name="Instrument" />
                    </StackPanel>
                    <StackPanel Margin="6">
                        <TextBlock Margin="0,0,0,5"
                                   Text="Tone" />
                        <ComboBox x:Name="ToneComboBox"
                                  MinWidth="150"
                                  AutomationProperties.Name="Tone" />
                    </StackPanel>
                    <StackPanel Margin="6">
                        <TextBlock Margin="0,0,0,5"
                                   Text="Playing style" />
                        <ComboBox x:Name="StyleComboBox"
                                  MinWidth="150"
                                  AutomationProperties.Name="Playing style" />
                    </StackPanel>
                    <StackPanel Margin="6">
                        <TextBlock Margin="0,0,0,5"
                                   Text="Capo fret" />
                        <ComboBox x:Name="CapoComboBox"
                                  MinWidth="150"
                                  AutomationProperties.Name="Capo fret" />
                    </StackPanel>
                    <StackPanel Margin="6">
                        <TextBlock Margin="0,0,0,5"
                                   Text="Audio backend" />
                        <ComboBox x:Name="AudioBackendComboBox"
                                  MinWidth="150"
                                  AutomationProperties.Name="Audio backend" />
                    </StackPanel>
                </UniformGrid>

                <CheckBox x:Name="NoVideoCheckBox"
                          Margin="0,10,0,0"
                          AutomationProperties.Name="Audio only, skip video analysis"
                          Content="Audio only (--no-video)" />
            </StackPanel>
        </Border>

        <Border x:Name="JobPanel"
                Grid.Row="4"
                Margin="0,18,0,0"
                Padding="20"
                BorderBrush="#D6D6D6"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,20,0"
                            VerticalAlignment="Center">
                    <ProgressBar x:Name="JobProgressBar"
                                 Height="8"
                                 Minimum="0"
                                 Maximum="100"
                                 AutomationProperties.Name="Transcription progress" />
                    <TextBlock x:Name="JobStatusText"
                               Margin="0,8,0,0"
                               Foreground="#666666"
                               Text="Choose an input to begin."
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button x:Name="TranscribeButton"
                        Grid.Column="1"
                        MinWidth="118"
                        Padding="14,9"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Transcribe selected video"
                        Click="Transcribe_Click"
                        Content="Transcribe"
                        IsEnabled="False" />
            </Grid>
        </Border>

        <Border x:Name="TabViewerPanel"
                Grid.Row="5"
                MinHeight="220"
                Margin="0,18,0,0"
                Padding="20"
                BorderBrush="#D6D6D6"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Text="ASCII tab" />
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   Foreground="#666666"
                                   Text="Export as" />
                        <ComboBox x:Name="ExportFormatComboBox"
                                  Width="125"
                                  Margin="0,0,8,0"
                                  VerticalContentAlignment="Center"
                                  AutomationProperties.Name="Export format"
                                  DisplayMemberPath="DisplayName" />
                        <Button x:Name="ExportButton"
                                MinWidth="78"
                                Padding="12,6"
                                AutomationProperties.Name="Export completed transcription"
                                Click="Export_Click"
                                Content="Export..."
                                IsEnabled="False" />
                        <Button x:Name="OpenEditorButton"
                                Margin="8,0,0,0"
                                MinWidth="78"
                                Padding="12,6"
                                AutomationProperties.Name="Open assisted editor"
                                Click="OpenEditor_Click"
                                Content="Edit..."
                                IsEnabled="False" />
                    </StackPanel>
                </Grid>
                <Border x:Name="LowConfidencePanel"
                        Grid.Row="1"
                        MaxHeight="180"
                        Margin="0,12,0,0"
                        Padding="12"
                        Background="#FFFBEA"
                        BorderBrush="#E5C86B"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="Collapsed">
                    <DockPanel>
                        <TextBlock x:Name="LowConfidenceCountText"
                                   DockPanel.Dock="Top"
                                   Margin="0,0,0,6"
                                   FontWeight="SemiBold"
                                   Foreground="#705600" />
                        <ListBox x:Name="LowConfidenceFlagsList"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 AutomationProperties.Name="Low-confidence flags"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,2"
                                               Text="{Binding}"
                                               TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
                <TextBox x:Name="TabViewerTextBox"
                         Grid.Row="2"
                         Margin="0,12,0,0"
                         Padding="12"
                         Background="#FAFAFA"
                         BorderBrush="#E0E0E0"
                         FontFamily="Consolas"
                         FontSize="13"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         AutomationProperties.Name="Completed ASCII tab"
                         HorizontalScrollBarVisibility="Auto"
                         IsReadOnly="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Border>

        <Border x:Name="SidecarErrorPanel"
                Grid.Row="5"
                MinHeight="180"
                Margin="0,18,0,0"
                Padding="20"
                Background="#FFF8F8"
                BorderBrush="#D9A0A0"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#8A2020"
                           Text="TabVision error" />
                <TextBox x:Name="SidecarErrorTextBox"
                         Grid.Row="1"
                         Margin="0,12,0,0"
                         Padding="12"
                         Background="White"
                         BorderBrush="#E8CACA"
                         FontFamily="Consolas"
                         FontSize="13"
                         AcceptsReturn="True"
                         AutomationProperties.Name="TabVision error text"
                         HorizontalScrollBarVisibility="Auto"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Border>
        </Grid>
    </ScrollViewer>
</Window>
